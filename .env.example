# Variables de entorno — se cargan en Netlify (Site configuration → Environment variables).
# Este archivo es solo referencia: NO poner valores reales acá.

# Tiendanube
TN_TOKEN=            # Access token de la app de Tiendanube (usado por scan.js y finanzas.js)
SCAN_KEY=            # Clave de acceso del escáner y las etiquetas

# Mercado Pago
MP_TOKEN=            # Access token de producción (finanzas, liberaciones, venta-mp)
ALERT_KEY=           # Clave de acceso del panel financiero y de las funciones por URL

# Telegram (bot @scatto_alertas_bot)
TG_TOKEN=            # Token del bot
TG_CHAT_ID=          # Chat al que se envían las alertas

# MercadoLibre (app propia en developers.mercadolibre.com.ar)
ML_APP_ID=
ML_SECRET=

# Supabase (persistencia de tokens de ML y memoria de avisos)
SUPABASE_URL=        # https://xxxx.supabase.co
SUPABASE_KEY=        # service_role key
